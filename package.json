{
  "name": "react-example",
  "private": true,
  "version": "1.0.2",
  "description": "IS King Panel - Windows Desktop Application for Minecraft Server Management",
  "author": "kingplayz",
  "main": "electron-main.cjs",
  "iskSigning": {
    "provider": "esigner",
    "expectedPublisher": "",
    "timestampServer": "http://timestamp.digicert.com",
    "hashAlgorithm": "sha256",
    "uninstallerName": "Uninstall IS King Panel.exe"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "runtime:check": "node scripts/fetch-runtime.mjs --check",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:data": "node scripts/check-tracked-data.mjs",
    "check:release": "node scripts/release-assets.mjs --runtime --privacy --signing",
    "verify:signing": "node scripts/verify-signatures.mjs",
    "check:docs": "node scripts/check-workflows-doc.mjs",
    "test": "node --import tsx --test test/*.test.mjs",
    "electron": "electron electron-main.cjs",
    "fixtures:upgrade": "node scripts/make-upgrade-fixtures.mjs",
    "verify:install-machine": "node scripts/verify-machine-install.mjs",
    "verify:upgrade": "node scripts/verify-installed-upgrade.mjs",
    "electron:build": "node scripts/build-release.mjs"
  },
  "build": {
    "appId": "com.kingplayz.iskingpanel",
    "productName": "IS King Panel",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "server.cjs",
      "electron-main.cjs",
      "updater-policy.cjs",
      "electron-preload.cjs",
      "runtime-resolver.cjs",
      "state-dirs.cjs",
      "!runtime/**/*",
      "package.json",
      "node_modules/**/*",
      "src/**/*",
      "!database/**/*",
      "!**/.env",
      "!**/.env.*",
      "!**/*.sqlite",
      "!**/*.sqlite-*",
      "!**/*.db",
      "!**/.local-*",
      "!**/.panel-*",
      "!**/mongodb_collections/**",
      "!**/*.bson.json",
      "!**/FIRST-RUN-CREDENTIALS.txt",
      "!**/state-migration.json",
      "!**/server_runtime.json",
      "!**/secrets/**",
      "!**/logs/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/*.log",
      "!**/*.log.*",
      "!**/*.bak",
      "!**/*.premigration-*",
      "!**/*.pfx",
      "!**/*.p12",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "server.cjs",
      "dist/**/*"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "node.exe",
          "LICENSE"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "asar": true,
      "artifactName": "IS-King-Panel-Setup-${version}.${ext}",
      "signExts": [
        "!node.exe"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IS King Panel"
    },
    "publish": {
      "provider": "github",
      "owner": "kingplayz1",
      "repo": "KingPanel"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.7.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.5",
    "node-fetch": "^3.3.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2",
    "sqlite": "^5.1.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/socket.io": "^3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
