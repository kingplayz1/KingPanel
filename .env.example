# KingPanel - Production Environment Configuration

## Required Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=production

# Session Security
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
SESSION_COOKIE_NAME=king_session

# OAuth Configuration
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
# Optional overrides for local testing against a mock Discord API.
# DISCORD_API_BASE=https://discord.com/api/v10
# DISCORD_OAUTH_BASE=https://discord.com/api

# Database Configuration
DATABASE_PATH=./database/isking_panel.sqlite
MONGODB_URI=mongodb://localhost:27017/isking_panel
REDIS_URL=redis://localhost:6379

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@iskingpanel.com

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=4
SESSION_TIMEOUT_HOURS=24

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/server.log

# Advanced Panel entitlement (Discord)
# Roles are read with the signed-in user's own OAuth grant (scope: guilds.members.read),
# so no bot is required and no guild-wide credential ships inside the app.
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_GUILD_NAME=IS King Official Discord Server
DISCORD_INVITE_URL=https://discord.gg/9PXsdgZ2PZ
# Role that unlocks the Advanced Panel; grant it in Discord (e.g. onboarding default
# roles) or with any bot you already run. Members without it stay in the Simple Panel.
DISCORD_ADVANCED_ROLE_ID=your-verified-role-id
# Optional legacy fallback. A bot token is only used to READ membership when an
# account has no stored OAuth grant. Leave empty unless you already run a bot — a
# token inside a packaged desktop app can be extracted by anyone who installs it.
DISCORD_BOT_TOKEN=

# Feature Flags
ENABLE_OAUTH=true
ENABLE_2FA=false
ENABLE_EMAIL_RESET=true